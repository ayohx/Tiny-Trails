/**
 * Tests for Tracing Utilities
 * Following Holiday Extras testing standards
 */

import {
  calculateDistance,
  isPointNearPoint,
  calculateCoverage,
  checkEraserCollision,
  smoothPath,
  Point,
  Stroke,
} from '@/features/tracing/tracingUtils';
import { generateMockStroke } from '../utils/testUtils';

describe('tracingUtils', () => {
  describe('calculateDistance', () => {
    it('should calculate distance between two points', () => {
      const p1: Point = { x: 0, y: 0 };
      const p2: Point = { x: 3, y: 4 };
      expect(calculateDistance(p1, p2)).toBe(5);
    });

    it('should return 0 for same point', () => {
      const p1: Point = { x: 10, y: 20 };
      const p2: Point = { x: 10, y: 20 };
      expect(calculateDistance(p1, p2)).toBe(0);
    });

    it('should handle negative coordinates', () => {
      const p1: Point = { x: -5, y: -5 };
      const p2: Point = { x: 5, y: 5 };
      const distance = calculateDistance(p1, p2);
      expect(distance).toBeCloseTo(14.142, 2);
    });
  });

  describe('isPointNearPoint', () => {
    it('should return true when points are within radius', () => {
      const p1: Point = { x: 0, y: 0 };
      const p2: Point = { x: 5, y: 0 };
      expect(isPointNearPoint(p1, p2, 10)).toBe(true);
    });

    it('should return false when points are outside radius', () => {
      const p1: Point = { x: 0, y: 0 };
      const p2: Point = { x: 20, y: 20 };
      expect(isPointNearPoint(p1, p2, 10)).toBe(false);
    });

    it('should return true when points are exactly at radius', () => {
      const p1: Point = { x: 0, y: 0 };
      const p2: Point = { x: 10, y: 0 };
      expect(isPointNearPoint(p1, p2, 10)).toBe(true);
    });
  });

  describe('calculateCoverage', () => {
    it('should return 0 for no guide dots', () => {
      const strokes: Stroke[] = [generateMockStroke()];
      const guideDots: Point[] = [];
      expect(calculateCoverage(strokes, guideDots)).toBe(0);
    });

    it('should return 100 when all dots are covered', () => {
      const guideDots: Point[] = [
        { x: 100, y: 100 },
        { x: 150, y: 150 },
        { x: 200, y: 200 },
      ];
      const strokes: Stroke[] = [generateMockStroke()];
      expect(calculateCoverage(strokes, guideDots, 50)).toBe(100);
    });

    it('should return 0 when no dots are covered', () => {
      const guideDots: Point[] = [
        { x: 500, y: 500 },
        { x: 600, y: 600 },
      ];
      const strokes: Stroke[] = [generateMockStroke()];
      expect(calculateCoverage(strokes, guideDots, 30)).toBe(0);
    });

    it('should calculate partial coverage correctly', () => {
      const guideDots: Point[] = [
        { x: 100, y: 100 }, // covered
        { x: 150, y: 150 }, // covered
        { x: 500, y: 500 }, // not covered
        { x: 600, y: 600 }, // not covered
      ];
      const strokes: Stroke[] = [generateMockStroke()];
      expect(calculateCoverage(strokes, guideDots, 50)).toBe(50);
    });
  });

  describe('checkEraserCollision', () => {
    it('should return true when eraser collides with stroke', () => {
      const eraserPoint: Point = { x: 100, y: 100 };
      const eraserRadius = 20;
      const stroke = generateMockStroke();
      expect(checkEraserCollision(eraserPoint, eraserRadius, stroke)).toBe(true);
    });

    it('should return false when eraser does not collide', () => {
      const eraserPoint: Point = { x: 500, y: 500 };
      const eraserRadius = 20;
      const stroke = generateMockStroke();
      expect(checkEraserCollision(eraserPoint, eraserRadius, stroke)).toBe(false);
    });
  });

  describe('smoothPath', () => {
    it('should return original path for less than 3 points', () => {
      const points: Point[] = [
        { x: 0, y: 0 },
        { x: 10, y: 10 },
      ];
      expect(smoothPath(points)).toEqual(points);
    });

    it('should smooth path with 3+ points', () => {
      const points: Point[] = [
        { x: 0, y: 0 },
        { x: 10, y: 10 },
        { x: 20, y: 20 },
      ];
      const smoothed = smoothPath(points);
      
      // First and last points should remain unchanged
      expect(smoothed[0]).toEqual(points[0]);
      expect(smoothed[smoothed.length - 1]).toEqual(points[points.length - 1]);
      
      // Middle point should be averaged
      expect(smoothed[1]).toEqual({ x: 10, y: 10 });
    });

    it('should preserve first and last points', () => {
      const points: Point[] = [
        { x: 0, y: 0 },
        { x: 50, y: 50 },
        { x: 100, y: 0 },
        { x: 150, y: 50 },
      ];
      const smoothed = smoothPath(points);
      
      expect(smoothed[0]).toEqual(points[0]);
      expect(smoothed[smoothed.length - 1]).toEqual(points[points.length - 1]);
    });
  });
});
