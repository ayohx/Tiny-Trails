# Environment Variables for Tiny Trails

# Sentry DSN for error tracking (optional - leave empty to disable)
# Get your DSN from: https://sentry.io/settings/projects/
EXPO_PUBLIC_SENTRY_DSN=

# Example with actual DSN (replace with yours):
# EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
